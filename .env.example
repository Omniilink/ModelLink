# OmniLink Server — example environment.
# Copy the lines you need into the real ".env" (next to run-server.py) and restart.
# Values in ".env" are read at startup; admin-controllable ones can also be set in the admin panel.

# ---- Upstream provider keys (server-wide; personal keys override per user) ----
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# GROQ_API_KEY=
# OPENROUTER_API_KEY=
# DEEPSEEK_API_KEY=
# MISTRAL_API_KEY=
# XAI_API_KEY=
# COHERE_API_KEY=
# OPENCODE_API_KEY=

# ---- Ollama (local models) ----
# The server-wide Ollama address. Default: http://localhost:11434
# If the server runs in Docker, use http://host.docker.internal:11434 or the host LAN IP.
OMNIILINK_OLLAMA_URL=http://localhost:11434
# Default local model (also the default workspace-merge model).
OLLAMA_MODEL=qwen2.5-coder:3b

# ---- Workspace AI merge (lock-free concurrent edits) ----
# Small local model that reconciles two people editing the same file.
# In Docker this is served by the dedicated "merge-ollama" container.
#   - OMNIILINK_MERGE_OLLAMA_URL: where the merge model lives. Empty = the
#     server's own Ollama. Compose sets it to the merge container.
#   - OMNIILINK_MERGE_MODEL: the tag imported from ./models/*.gguf.
# Set ENABLED=0 to disable and restore the old wait-for-the-file behaviour.
OMNIILINK_MERGE_OLLAMA_URL=http://merge-ollama:11434
OMNIILINK_MERGE_MODEL=gemma-merge:2b
OMNIILINK_MERGE_ENABLED=1

# ---- Auth / admin ----
# Comma-separated usernames that become server admins on first signup.
# OMNIILINK_ADMIN_USERS=yourname
