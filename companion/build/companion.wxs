<?xml version="1.0" encoding="UTF-8"?>
<!-- Omniilink Server installer (WiX v3). Rebuild with build.bat. -->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Product Id="*" Name="Omniilink Server" Language="1033" Version="1.0.12"
           Manufacturer="Omniilink" UpgradeCode="12EF83D7-102A-4CE7-AC8D-2FEA1B3C89F0">
    <Package InstallerVersion="500" Compressed="yes" InstallScope="perMachine" Platform="x64" />
    <Icon Id="AppIcon" SourceFile="$(var.IconDir)\icon.ico" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon" />
    <MajorUpgrade Schedule="afterInstallExecute"
                  DowngradeErrorMessage="A newer version of Omniilink Server is already installed." />
    <MediaTemplate EmbedCab="yes" />
    <UIRef Id="WixUI_Minimal" />

    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFiles64Folder">
        <Directory Id="INSTALLDIR" Name="Omniilink Server">
          <Component Id="ServerExe" Guid="*" Win64="yes">
            <File Id="OmniilinkServer.exe" Name="OmniilinkServer.exe"
                  Source="$(var.ExeSourceDir)\OmniilinkServer.exe" KeyPath="yes" />
            <Shortcut Id="StartMenuShortcut" Directory="ProgramMenuDir"
                      Name="Omniilink Server"
                      Target="[#OmniilinkServer.exe]"
                      Icon="AppIcon"
                      WorkingDirectory="INSTALLDIR" />
            <Shortcut Id="StartupShortcut" Directory="StartupDir"
                      Name="Omniilink Server"
                      Target="[#OmniilinkServer.exe]"
                      Arguments="tray"
                      Icon="AppIcon"
                      WorkingDirectory="INSTALLDIR" />
          </Component>
        </Directory>
      </Directory>
      <Directory Id="ProgramMenuFolder">
        <Directory Id="ProgramMenuDir" Name="Omniilink Server">
          <Component Id="ProgramMenuComponent" Guid="*">
            <RemoveFolder Id="ProgramMenuDir" On="uninstall" />
            <RegistryValue Root="HKCU" Key="Software\Omniilink Server"
                           Name="installed" Value="1" Type="integer" KeyPath="yes" />
          </Component>
        </Directory>
        <Directory Id="OldProgramMenuDir" Name="Omniilink Companion">
          <Component Id="OldShortcutsCleanup" Guid="*">
            <RemoveFile Id="OldStartMenuLnk" Directory="OldProgramMenuDir"
                        Name="Omniilink Companion.lnk" On="install" />
            <RemoveFile Id="OldStartupLnk" Directory="StartupDir"
                        Name="Omniilink Companion.lnk" On="install" />
            <RegistryValue Root="HKCU" Key="Software\Omniilink Server"
                           Name="cleaned" Value="1" Type="integer" KeyPath="yes" />
          </Component>
        </Directory>
      </Directory>
      <Directory Id="StartupFolder">
        <Directory Id="StartupDir" />
      </Directory>
    </Directory>

    <Feature Id="Main" Title="Omniilink Server" Level="1">
      <ComponentRef Id="ServerExe" />
      <ComponentRef Id="ProgramMenuComponent" />
      <ComponentRef Id="OldShortcutsCleanup" />
    </Feature>
  </Product>
</Wix>
