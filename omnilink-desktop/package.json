{
  "name": "omnilink-desktop",
  "private": true,
  "version": "0.1.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "smoke": "node scripts/smoke.mjs",
    "test:parser": "esbuild scripts/test-stream-parser.mjs --bundle --platform=node --format=esm --outfile=scripts/.test-parser.built.mjs --log-level=error && node scripts/.test-parser.built.mjs",
    "test:models": "esbuild scripts/test-model-e2e.mjs --bundle --platform=node --format=esm --outfile=scripts/.test-e2e.built.mjs --alias:@/lib/tauri=./scripts/stub-tauri.mjs --alias:@=./src --log-level=error && node scripts/.test-e2e.built.mjs",
    "test:release": "node scripts/test-release-app.mjs",
    "test:release:opencode": "node scripts/test-release-opencode.mjs",
    "tauri": "tauri"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@monaco-editor/react": "^4.7.0",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-updater": "^2.14.1",
    "clsx": "^2.1.1",
    "framer-motion": "^14.7.1",
    "lucide-react": "^1.63.0",
    "monaco-editor": "^0.57.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.7.0",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.12.4",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "esbuild": "^0.28.2",
    "oxlint": "^1.89.0",
    "playwright-core": "^1.64.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~7.0.2",
    "vite": "^8.3.5"
  }
}
