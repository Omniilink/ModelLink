#!/usr/bin/env python3
"""Host-side self update, executed inside the throwaway updater container.

/work is the host checkout bind-mounted from the daemon (drive-letter
source, the same mechanic as the execution sandbox). HOST_CHECKOUT is the
host-side path of that same directory (e.g. C:/Modellink).

Why the override file: a compose CLI running inside a container resolves
relative bind mounts (./user_data) against the container filesystem
(/work/...), but the daemon needs host paths (C:/...). A wrong path would
make the daemon silently mount a fresh empty directory over real data, so
every rewritten source is verified to exist BEFORE compose ever runs.

Flow: verify repo -> git pull --ff-only -> build sandbox image ->
generate absolute-path override -> preflight bind sources ->
compose up -d --build api. Any failure aborts before touching containers,
except a failed `up` itself (reported loudly; recover with update.bat).

`--check` never touches containers: it verifies the checkout, fetches the
current branch and reports how far HEAD is from origin so the api can decide
whether an auto-update is due. Exit codes: 0 up to date, 3 behind (safe to
fast-forward), 4 local commits not on origin / diverged, 1 cannot tell.
"""
import os
import posixpath
import re
import subprocess
import sys

# The checkout this script works on: /work inside the throwaway container,
# or the real checkout when the api runs `--check` natively (where PyYAML
# may not be installed, so yaml is imported lazily by main()).
WORK = os.environ.get("OMNI_UPDATE_WORK", "/work").replace("\\", "/").rstrip("/") or "/work"
HOST = os.environ.get("HOST_CHECKOUT", "").replace("\\", "/").rstrip("/")
BASE_FILE = "docker-compose.yml"
OVERRIDE_FILE = "/tmp/omni-abs-volumes.yml"
UP_SERVICES = ["api"]
BUILD_SERVICES = ["sandbox-image"]
# The ONLY repositories this script will ever pull from: the project lives
# under two names (the account was renamed, both URLs still resolve to the
# same commits). A checkout whose origin points anywhere else (tampered
# remote, wrong clone) is refused. Override with a comma-separated list in
# OMNIILINK_GIT_REPO.
DEFAULT_REPOS = ("https://github.com/Omniilink/ModelLink.git,"
                 "https://github.com/Tribbninja/ModelLink.git")
# https://<anything>@host/... -> the credential part of a remote URL.
_RE_URL_CRED = re.compile(r"(://)[^/@]+@")


def log(msg):
    print(msg, flush=True)


def run(cmd):
    log("+ " + " ".join(cmd))
    return subprocess.run(cmd, cwd=WORK).returncode


def fail(msg):
    log("ABORT: " + msg)
    sys.exit(1)


def _drop_token_file():
    """The API passes GIT_TOKEN via a single-use file; remove it first so
    the secret lives as briefly as possible (the daemon already consumed it
    when this container was created)."""
    tok_file = os.environ.get("GIT_TOKEN_FILE", "").strip()
    if tok_file and os.path.isfile(tok_file):
        try:
            os.remove(tok_file)
            log("single-use token file removed")
        except OSError:
            pass


def git_auth_args():
    """Extra git args carrying the token, or [] for anonymous access.

    Uses an Authorization header so the secret never lands in the repo
    config, the shell history, or the job log."""
    import base64
    token = os.environ.get("GIT_TOKEN", "").strip()
    if not token:
        return []
    cred = base64.b64encode(f"x-access-token:{token}".encode()).decode()
    return ["-c", f"http.extraHeader=AUTHORIZATION: basic {cred}"]


def _mask_arg(a):
    """Redact the Authorization header for the log (the token must never
    appear in job output)."""
    return "***" if "AUTHORIZATION" in a else a


def git_pull():
    args = ["git"] + git_auth_args() + ["pull", "--ff-only"]
    log("+ " + " ".join(_mask_arg(a) for a in args))
    p = subprocess.run(args, cwd=WORK, capture_output=True, text=True)
    sys.stdout.write(_redact(p.stdout or ""))
    sys.stdout.flush()
    sys.stderr.write(_redact(p.stderr or ""))
    sys.stderr.flush()
    if p.returncode != 0:
        out = _redact((p.stdout or "") + (p.stderr or ""))
        if ("could not read Username" in out or "Authentication failed" in out
                or "401" in out or "403" in out):
            if os.environ.get("GIT_TOKEN", "").strip():
                fail("GitHub rejected the token. Create a fresh one "
                     "(GitHub Settings -> Developer settings -> Personal access "
                     "tokens, classic `repo` scope) and set OMNIILINK_GIT_TOKEN "
                     "in the server .env, then retry.")
            fail("GitHub asks for credentials and none were provided. "
                 "Create a token (GitHub Settings -> Developer settings -> "
                 "Personal access tokens, classic `repo` scope) and set "
                 "OMNIILINK_GIT_TOKEN in the server .env, then retry.")
        fail("git pull --ff-only failed (diverged history or no network?)")


def _norm_repo(url):
    """Normalise a git URL so https/ssh/scp forms compare equal. Embedded
    credentials (https://<token>@host/...) are dropped: the identity is the
    repository, not how we happen to authenticate to it."""
    u = (url or "").strip().rstrip("/")
    for pfx in ("https://", "http://", "ssh://git@", "git://", "ssh://"):
        if u.startswith(pfx):
            u = u[len(pfx):]
            break
    if u.startswith("git@"):
        u = u[4:].replace(":", "/", 1)
    else:
        head, sep, tail = u.partition("/")
        if "@" in head:
            u = head.rsplit("@", 1)[1] + ((sep + tail) if sep else "")
    if u.endswith(".git"):
        u = u[:-4]
    return u.lower().rstrip("/")


def _git(args, auth=None, capture=True):
    """Run git in the checkout. Returns the CompletedProcess."""
    argv = ["git"] + list(auth or []) + list(args)
    return subprocess.run(argv, cwd=WORK, capture_output=capture, text=True)


def _git_out(args, auth=None):
    return (_git(args, auth).stdout or "")


def _redact(text):
    """Hide credentials embedded in a remote URL (https://<token>@host/...)
    before they reach a log line, the panel or the audit trail. Applied to
    every blob of git output we echo: git itself prints the full URL."""
    return _RE_URL_CRED.sub(r"\1***@", text or "")


def _allowed_repos():
    """Comma-separated allowlist, normalised for comparison."""
    raw = os.environ.get("OMNIILINK_GIT_REPO", "").strip() or DEFAULT_REPOS
    return [_norm_repo(x) for x in raw.split(",") if x.strip()]


def _verify_git_repo():
    """Shared preflight: real checkout, trusted origin, expected repo.

    Returns the (redacted) origin URL."""
    if not os.path.isdir(os.path.join(WORK, ".git")):
        fail("no .git under /work (not a checkout, refusing to pull)")
    # The repo is owned by the host user while we run as root.
    subprocess.run(["git", "config", "--global", "--add", "safe.directory", WORK],
                   capture_output=True)
    got = _git_out(["config", "--get", "remote.origin.url"]).strip()
    if not got:
        fail("this checkout has no remote.origin.url; refusing to touch it")
    allowed = _allowed_repos()
    if _norm_repo(got) not in allowed:
        fail(f"origin '{_redact(got)}' is not one of the expected repositories "
             f"({', '.join(allowed)}); refusing to pull from it")
    return _redact(got)


def _tracked_changes():
    """True when a TRACKED file is modified (untracked .env/user_data never
    block: those are supposed to live outside the repo)."""
    out = _git_out(["status", "--porcelain", "--untracked-files=no"])
    return bool(out.strip())


def check_mode():
    """Report how far HEAD is from origin. Writes KEY=value lines the api
    parses, then exits 0 (up to date), 3 (behind -> safe to fast-forward),
    4 (local commits are not on origin) or 1 (cannot tell)."""
    origin = _verify_git_repo()
    _drop_token_file()
    branch = _git_out(["rev-parse", "--abbrev-ref", "HEAD"]).strip()
    if not branch or branch == "HEAD":
        fail("detached HEAD; cannot tell which branch to follow")
    auth = git_auth_args()
    log("+ " + " ".join(_mask_arg(a) for a in ["git"] + auth + ["fetch", "--quiet",
                                                               "origin", branch]))
    p = _git(["fetch", "--quiet", "origin", branch], auth)
    if p.returncode != 0:
        out = _redact((p.stdout or "") + (p.stderr or ""))
        sys.stdout.write(out)
        sys.stdout.flush()
        if ("could not read Username" in out or "Authentication failed" in out
                or "401" in out or "403" in out):
            if os.environ.get("GIT_TOKEN", "").strip():
                fail("GitHub rejected the token; set a fresh OMNIILINK_GIT_TOKEN "
                     "in the server .env")
            fail("GitHub asks for credentials and none were provided; set "
                 "OMNIILINK_GIT_TOKEN in the server .env")
        fail("git fetch failed (no network?)")
    local = _git_out(["rev-parse", "HEAD"]).strip()
    remote = _git_out(["rev-parse", "FETCH_HEAD"]).strip()
    if not local or not remote:
        fail("could not read HEAD/FETCH_HEAD after the fetch")
    print(f"BRANCH={branch}", flush=True)
    print(f"ORIGIN={origin}", flush=True)
    print(f"LOCAL={local}", flush=True)
    print(f"REMOTE={remote}", flush=True)
    print("DIRTY=" + ("1" if _tracked_changes() else "0"), flush=True)
    if local == remote:
        sys.exit(0)
    fast_forwardable = _git(["merge-base", "--is-ancestor", "HEAD", "FETCH_HEAD"]).returncode == 0
    sys.exit(3 if fast_forwardable else 4)


def _split_short(entry):
    """Split a short-syntax volume into (source, target, opts-or-None).

    Returns (None, entry, None) for named volumes and anything unparseable
    (both are passed through untouched).
    """
    if not isinstance(entry, str):
        return None, entry, None
    m = re.match(r"^(?:([a-zA-Z]:/[^:]*)|([^:]+)):([^:]+)(?::(.*))?$", entry)
    if not m:
        return None, entry, None
    src = m.group(1) if m.group(1) is not None else m.group(2)
    if m.group(1) is None and "/" not in src and not src.startswith("."):
        return None, entry, None  # named volume, e.g. db-data:/var/lib/x
    return src, m.group(3), m.group(4)


def _rewrite_source(src):
    """Map a volume source to its host-absolute form.

    Returns (new_source, work_path_or_None). work_path is the same file as
    seen from inside this container, for the preflight existence check.
    Unresolvable forms return (src, None) and are passed through untouched.
    """
    s = src.replace("\\", "/")
    if s.startswith("./") or s.startswith("../") or s == "." or s == "..":
        rel = posixpath.normpath(s)
        host_path = posixpath.normpath(HOST + "/" + rel)
        work_path = posixpath.normpath(os.path.join(WORK, rel))
        return host_path, work_path
    if s.startswith("~"):
        fail(f"volume source '{src}' uses ~ (unresolvable here); "
             "run update.bat on the host instead")
    return src, None


def main():
    import yaml
    if not HOST:
        fail("HOST_CHECKOUT is not set in the updater container")
    base = os.path.join(WORK, BASE_FILE)
    if not os.path.isfile(base):
        fail(f"no {BASE_FILE} under /work (wrong directory mounted?)")
    _verify_git_repo()
    _drop_token_file()
    if _tracked_changes():
        fail("this checkout has uncommitted changes to tracked files; "
             "commit or stash them (or run update.bat on the host) first")
    git_pull()
    try:
        with open(base, encoding="utf-8") as fh:
            doc = yaml.safe_load(fh)
    except Exception as exc:
        fail(f"cannot parse {BASE_FILE}: {exc}")
    services = (doc or {}).get("services") or {}
    for t in UP_SERVICES + BUILD_SERVICES:
        if t not in services:
            log(f"NOTE: service '{t}' not found in {BASE_FILE}, skipping it")
    # --- sandbox image first: a failed build must never touch the api ---
    for t in BUILD_SERVICES:
        if t in services:
            if run(["docker", "compose", "-f", BASE_FILE, "build", t]) != 0:
                fail(f"building service '{t}' failed, api left untouched")
    # --- absolute-path override for the services `up` will recreate ---
    override = {"services": {}}
    rewritten = []  # (host_path, work_path) pairs to preflight
    for t in UP_SERVICES:
        if t not in services:
            continue
        fixed = []
        for v in ((services[t] or {}).get("volumes") or []):
            if isinstance(v, dict):
                src = v.get("source", "")
                if v.get("type", "bind") != "bind" or not src or "${" in src:
                    fixed.append(v)
                    continue
                new_src, work_path = _rewrite_source(src)
                if work_path:
                    rewritten.append((new_src, work_path))
                fixed.append({**v, "source": new_src})
                continue
            src, target, opts = _split_short(v)
            if src is None or "${" in v:
                fixed.append(v)
                continue
            new_src, work_path = _rewrite_source(src)
            if work_path:
                rewritten.append((new_src, work_path))
            short = f"{new_src}:{target}" + (f":{opts}" if opts else "")
            fixed.append(short)
        override["services"][t] = {"volumes": fixed}
    if not override["services"]:
        fail("nothing to update (no known services in docker-compose.yml)")
    with open(OVERRIDE_FILE, "w", encoding="utf-8") as fh:
        yaml.safe_dump(override, fh)
    log("volume override written to " + OVERRIDE_FILE + ":")
    for t, svc in override["services"].items():
        for v in svc["volumes"]:
            log(f"  {t}: {v}")
    # --- preflight: every path WE introduce must already exist ---
    for host_path, work_path in rewritten:
        if not os.path.exists(work_path):
            fail(f"host path '{host_path}' does not exist; the daemon would "
                 "mount an empty directory over real data. "
                 "Run update.bat on the host once to repair it.")
    log(f"preflight ok ({len(rewritten)} bind sources verified)")
    # --- the actual update, scoped to the api service only ---
    if run(["docker", "compose", "-f", BASE_FILE, "-f", OVERRIDE_FILE,
            "up", "-d", "--build"] + [t for t in UP_SERVICES if t in services]) != 0:
        fail("docker compose up failed; the api may be down. "
             "Run update.bat on the host to recover.")
    run(["docker", "compose", "-f", BASE_FILE, "-f", OVERRIDE_FILE,
         "ps"] + [t for t in UP_SERVICES if t in services])
    log("UPDATE DONE. The api container was recreated; refresh this page.")


if __name__ == "__main__":
    if "--check" in sys.argv[1:]:
        check_mode()
    else:
        main()
